---
import '../styles/landing.css';
import { APP_URL } from '../i18n';

// Served by Cloudflare Pages as the not-found page (dist/404.html, status 404).
// Strings are inline: three short messages, not worth a full locale dictionary.
const appUrl = APP_URL.replace(/\/$/, '');
const loginUrl = `${appUrl}/login`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · Wakil</title>
    <meta name="description" content="الصفحة غير موجودة · Page introuvable · Page not found" />
    <meta name="robots" content="noindex" />
    <link rel="preload" href="/fonts/ibm-plex-sans-arabic/IBMPlexSansArabic-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="logo" href="/" lang="ar">وكيل <span class="logo-latin">Wakil</span></a>
        <div class="nav-links">
          <a class="nav-login" href={loginUrl}>تسجيل الدخول</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="nf-title">
        <div class="hero-copy">
          <p class="ar-kicker" lang="ar" dir="rtl">404</p>
          <h1 id="nf-title" lang="ar" dir="rtl">هذه الصفحة غير موجودة.</h1>
          <p class="lede" lang="ar" dir="rtl">الرابط غير صحيح أو انتقلت الصفحة. ارجع إلى الصفحة الرئيسية أو إلى تسجيل الدخول.</p>
          <div class="ctas">
            <a class="btn btn-primary" href="/" lang="ar">الصفحة الرئيسية</a>
            <a class="btn" href={loginUrl} lang="ar">تسجيل الدخول</a>
          </div>

          <p class="lede" lang="fr" dir="ltr">Cette page n'existe pas. Retournez à l'accueil ou connectez-vous.</p>
          <p class="lede" lang="en" dir="ltr">This page doesn't exist. Go back to the home page or log in.</p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>© Wakil</p>
    </footer>
  </body>
</html>
