# Dashboard SPA routes. Each one serves the dashboard shell (app.html) with a 200 rewrite.
# Targets are written without ".html": Pages redirects a rewrite to "/app.html" to "/app" (308),
# while "/app" serves app.html directly.
# There is deliberately no catch-all: "/", "/fr/*", "/en/*", "/fonts/*" and every other static
# file are served from the landing build and the dashboard assets as usual.
/login /app 200
/signup /app 200
/reset-password /app 200
/privacy /app 200
/terms /app 200
/data-deletion /app 200
/onboarding /app 200
/inbox /app 200
/catalog /app 200
/orders /app 200
/assistant /app 200
/channels /app 200
/settings /app 200
/inbox/* /app 200
/catalog/* /app 200
/orders/* /app 200
/assistant/* /app 200
/channels/* /app 200
/settings/* /app 200
