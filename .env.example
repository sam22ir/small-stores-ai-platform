# Meta app: Instagram API with Instagram Login (see docs/instagram-setup.md).
# These are Supabase Edge Function secrets, never put them in the browser app.
# Instagram App ID / App secret: Meta dashboard > Instagram > API setup with Instagram login > 3. Set up business login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Webhook signature check also accepts the Facebook app secret (App settings > Basic), for Messenger later.
META_APP_SECRET=
# Any long random string you invent; paste the same value in the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
# Where the owner's browser returns after connecting Instagram (the deployed dashboard, no trailing slash).
DASHBOARD_URL=https://your-dashboard.example

# Supabase (webhook worker uses the service role; never expose it to the browser)
SUPABASE_URL=https://xewaswcuccpankghkmhz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://xewaswcuccpankghkmhz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_93ENCCijagl2q5hG0PBEQg_UjwClGPx

# Agent
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5-5 in code when unset.
AGENT_MODEL=claude-sonnet-5-5

# Optional: test with any OpenAI-compatible provider instead of Claude (fake data only).
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.tokenrouter.com/v1
# LLM_API_KEY=
# LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
#
# GPT-6 Luna directly on OpenAI (function calling on Chat Completions needs effort "none"):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-6-luna
# LLM_TOKEN_PARAM=max_completion_tokens
# LLM_REASONING_EFFORT=none
# Optional: LLM_TEMPERATURE=0.2 (omitted by default; reasoning models often reject it)

# Optional fallback, tried when the primary errors or times out (same names, LLM_FALLBACK_ prefix).
# Example: primary = a cheap reseller endpoint, fallback = official OpenAI.
# LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=gpt-6-luna
# LLM_FALLBACK_TOKEN_PARAM=max_completion_tokens
# LLM_FALLBACK_REASONING_EFFORT=none

# Dev-only: protects the dev mode of the assistant-chat function (any long random string)
PLAYGROUND_SECRET=
# Stores the dev secret may use (comma-separated uuids). Keep real stores out of this list.
PLAYGROUND_STORE_IDS=

# Telegram alerts to the store owner (see docs/instagram-setup.md). Leave TELEGRAM_BOT_TOKEN empty to turn alerts off.
TELEGRAM_BOT_TOKEN=
# Any long random string; the same value is sent by Telegram as X-Telegram-Bot-Api-Secret-Token (setWebhook secret_token).
TELEGRAM_WEBHOOK_SECRET=

# Chargily Pay V2 (subscription checkout and webhook; see docs/deploy.md). Secret key: Chargily dashboard > Developers.
CHARGILY_SECRET_KEY=
# Test: https://pay.chargily.net/test/api/v2   Live: https://pay.chargily.net/api/v2
CHARGILY_API_BASE=https://pay.chargily.net/test/api/v2
# Set to true only after a live payment works; until then no store is ever cut off.
BILLING_ENFORCED=

# Encrypts each store's Instagram token at rest: 32 random bytes, base64.  openssl rand -base64 32
# Keep a copy somewhere safe: without it every store has to connect Instagram again.
CREDENTIALS_ENCRYPTION_KEY=
